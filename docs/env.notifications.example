# Order owner notifications (optional — each channel skips if unset)

# --- Email (Resend) ---
# https://resend.com → API Keys
RESEND_API_KEY=
# Verified sender after domain setup, e.g. "Mahadev Mobiles <orders@yourdomain.com>"
# Until then Resend allows: Mahadev Mobiles <onboarding@resend.dev> (to your Resend account email only)
ORDER_NOTIFY_FROM_EMAIL=
# Optional override; otherwise uses store_settings.email from Admin → Settings
ORDER_NOTIFY_TO_EMAIL=

# --- WhatsApp via CallMeBot ---
# 1) On the OWNER phone, add +34 644 51 95 23 in WhatsApp and send: I allow callmebot to send me messages
# 2) Bot replies with your apikey — put it here
# 3) Store WhatsApp number in Admin must match that same phone (E.164 digits, e.g. 9198xxxxxxxx)
CALLMEBOT_API_KEY=

# --- Browser push (admin phone/desktop) ---
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push service
VAPID_SUBJECT=mailto:owner@example.com
